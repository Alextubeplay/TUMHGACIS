[sub_resource type="GDScript" id="GDScript_vlx1f"]
script/source = "extends Control

# Укажи здесь точный путь к узлу, на котором висит Tasks_manager.gd в твоей главной сцене.
# Если он лежит в Main/Monitor/Monitor_hud/..., то путь будет примерно таким:
@onready var tasks_manager = get_node_or_null(\"/root/Main/Monitor/Monitor_hud/Control/Tasks_manager\")

func _ready():
	# Проверяем, нашли ли мы менеджер задач в игре
	if tasks_manager:
		# Программно подключаем сигнал mouse_entered к функции в Tasks_manager.gd
		mouse_entered.connect(tasks_manager.on_hover_exit_zone_mouse_entered)
	else:
		# Если не нашли по прямому пути, пробуем найти его динамически в группе (на всякий случай)
		var nodes = get_tree().get_nodes_in_group(\"tasks_manager_group\")
		if nodes.size() > 0:
			mouse_entered.connect(nodes[0].on_hover_exit_zone_mouse_entered)
"

